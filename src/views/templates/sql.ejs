<h1>📝 SQL Query<% if (data.database) { %> — <%= data.database %><% } %></h1>
<div class="actions">
  <a href="<%= data.database ? '/db/' + encodeURIComponent(data.database) : '/' %>" class="btn">← Back</a>
  <% if (data.readOnly) { %><span class="badge">🔒 Read-only</span><% } %>
</div>
<div class="sql-workspace">
  <div class="card sql-editor">
  <form id="sqlQueryForm" method="POST" action="<%= data.database ? '/db/' + encodeURIComponent(data.database) + '/sql' : '/sql' %>"
    data-history-scope="<%= data.database || 'global' %>" data-explain-prefix="<%= data.explainPrefix %>">
    <div class="form-group">
      <div class="sql-editor-label">
        <label for="sql-input">SQL Statement</label>
        <span>Ctrl/⌘ + Enter to execute</span>
      </div>
      <div class="sql-code-editor">
        <pre id="sql-highlight" aria-hidden="true"><code></code></pre>
        <textarea id="sql-input" name="sql" spellcheck="false" autocomplete="off"
          aria-label="SQL statement" placeholder="SELECT * FROM ..."><%= data.sql || '' %></textarea>
        <div id="sqlSuggestions" class="sql-suggestions" hidden></div>
      </div>
    </div>
    <div class="sql-toolbar">
      <div class="form-group" style="margin:0;">
        <label>Timeout (ms)</label>
        <input type="number" name="timeoutMs" value="<%= data.queryTimeoutMs %>" min="100"
          max="300000" step="100" style="width:130px">
      </div>
      <button id="executeQueryButton" type="submit" class="btn btn-primary">▶ Execute</button>
      <button id="explainQueryButton" type="button" class="btn">Explain</button>
      <button id="saveQueryButton" type="button" class="btn">Save query</button>
      <% if (data.canCancel) { %>
        <button id="cancelQueryButton" type="button" class="btn btn-danger" hidden>■ Cancel</button>
      <% } %>
      <span id="queryStatus" style="color:var(--text2);font-size:13px;"></span>
    </div>
    <% if (!data.canCancel) { %>
      <small style="display:block;margin-top:8px;color:var(--text2);">
        SQLite executes in-process; live timeout and cancellation are available for MySQL connections.
      </small>
    <% } %>
  </form>
  </div>
  <aside class="card query-history" aria-labelledby="query-history-title">
    <div class="query-history-heading">
      <h2 id="query-history-title">Recent Queries</h2>
      <button type="button" id="clearQueryHistory" class="text-button">Clear</button>
    </div>
    <div id="queryHistoryList"></div>
    <p id="queryHistoryEmpty">Executed queries will appear here on this device.</p>
    <div class="query-history-heading saved-query-heading">
      <h2>Saved & snippets</h2>
    </div>
    <div id="savedQueryList"></div>
    <p id="savedQueryEmpty">Save a query with Ctrl/⌘ + S.</p>
  </aside>
</div>
<% if (data.result) { %>
  <% if (data.result.message) { 
    const isError = data.result.message.startsWith('Error:');
  %>
    <div class="msg <%= isError ? 'msg-error' : 'msg-success' %>"><%= data.result.message %></div>
  <% } %>
  <% if (data.result.rows.length > 0) { 
    const fields = data.result.fields.map(f => f.name);
  %>
    <div class="card" style="padding:0;overflow:hidden;margin-top:16px;">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <% fields.forEach(function(f) { %>
                <th><%= f %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% data.result.rows.forEach(function(row) { %>
              <tr>
                <% fields.forEach(function(f) { %>
                  <td><% if (row[f] === null) { %><span class="null">NULL</span><% } else { %><%= String(row[f]) %><% } %></td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="query-result-meta">
      <span>Returned <strong><%= data.result.rows.length.toLocaleString() %></strong> row<%= data.result.rows.length === 1 ? '' : 's' %></span>
      <span>Execution <strong><%= data.executionTimeMs %> ms</strong></span>
      <span class="query-result-actions">
        <button type="button" class="text-button" data-export-result="csv">Download CSV</button>
        <button type="button" class="text-button" data-export-result="json">Download JSON</button>
      </span>
    </div>
  <% } else if (data.executionTimeMs !== undefined) { %>
    <div class="query-result-meta">
      <span>Execution <strong><%= data.executionTimeMs %> ms</strong></span>
    </div>
  <% } %>
<% } %>

<script id="sqlAutocompleteData" type="application/json"><%- JSON.stringify(data.autocomplete).replace(/</g, '\\u003c') %></script>
<script id="sqlResultData" type="application/json"><%- JSON.stringify(data.result ? data.result.rows : [], function(_key, value) {
  return typeof value === 'bigint' ? String(value) : value;
}).replace(/</g, '\\u003c') %></script>

<script>
(function () {
  const form = document.getElementById('sqlQueryForm');
  const executeButton = document.getElementById('executeQueryButton');
  const explainButton = document.getElementById('explainQueryButton');
  const cancelButton = document.getElementById('cancelQueryButton');
  const status = document.getElementById('queryStatus');
  const input = document.getElementById('sql-input');
  const highlight = document.querySelector('#sql-highlight code');
  const highlightLayer = document.getElementById('sql-highlight');
  const historyList = document.getElementById('queryHistoryList');
  const historyEmpty = document.getElementById('queryHistoryEmpty');
  const clearHistory = document.getElementById('clearQueryHistory');
  const saveQueryButton = document.getElementById('saveQueryButton');
  const savedQueryList = document.getElementById('savedQueryList');
  const savedQueryEmpty = document.getElementById('savedQueryEmpty');
  const suggestions = document.getElementById('sqlSuggestions');
  const autocomplete = JSON.parse(document.getElementById('sqlAutocompleteData').textContent);
  const historyKey = `nodamin-query-history:${form.dataset.historyScope}`;
  const savedKey = `nodamin-saved-queries:${form.dataset.historyScope}`;
  const keywords = ['SELECT', 'FROM', 'WHERE', 'JOIN', 'LEFT JOIN', 'INNER JOIN', 'GROUP BY',
    'ORDER BY', 'HAVING', 'LIMIT', 'INSERT INTO', 'VALUES', 'UPDATE', 'SET', 'DELETE FROM',
    'CREATE TABLE', 'ALTER TABLE', 'DROP TABLE', 'WITH', 'AS', 'DISTINCT', 'EXPLAIN'];
  const reusableSnippets = [
    { name: 'Select rows', sql: 'SELECT * FROM table_name LIMIT 100;' },
    { name: 'Count rows', sql: 'SELECT COUNT(*) AS total FROM table_name;' },
    { name: 'Find duplicates', sql: 'SELECT column_name, COUNT(*) AS total\\nFROM table_name\\nGROUP BY column_name\\nHAVING COUNT(*) > 1;' },
  ];
  let queryId = null;

  function escapeHtml(value) {
    return value.replace(/[&<>]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[character]);
  }

  function highlightSql(value) {
    const tokenPattern = /(--[^\n]*|\/\*[\s\S]*?\*\/)|('(?:''|[^'])*'|"(?:[^"]|"")*")|\b(SELECT|FROM|WHERE|JOIN|LEFT|RIGHT|INNER|OUTER|ON|AS|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|ALTER|DROP|TABLE|DATABASE|INDEX|VIEW|WITH|GROUP|BY|ORDER|HAVING|LIMIT|OFFSET|UNION|ALL|DISTINCT|EXPLAIN|PRAGMA|SHOW|DESCRIBE|AND|OR|NOT|NULL|IS|IN|LIKE|ASC|DESC)\b|\b(\d+(?:\.\d+)?)\b/gi;
    let output = '';
    let lastIndex = 0;
    for (const match of value.matchAll(tokenPattern)) {
      output += escapeHtml(value.slice(lastIndex, match.index));
      const className = match[1] ? 'sql-comment' : match[2] ? 'sql-string' : match[3] ? 'sql-keyword' : 'sql-number';
      output += `<span class="${className}">${escapeHtml(match[0])}</span>`;
      lastIndex = match.index + match[0].length;
    }
    output += escapeHtml(value.slice(lastIndex));
    highlight.innerHTML = `${output}\n`;
  }

  function getHistory() {
    try {
      const history = JSON.parse(localStorage.getItem(historyKey) || '[]');
      return Array.isArray(history) ? history : [];
    } catch {
      return [];
    }
  }

  function saveHistory(sql) {
    const normalized = sql.trim();
    if (!normalized) return;
    const history = getHistory().filter(item => item !== normalized);
    history.unshift(normalized);
    localStorage.setItem(historyKey, JSON.stringify(history.slice(0, 12)));
    renderHistory();
  }

  function renderHistory() {
    const history = getHistory();
    historyList.replaceChildren();
    historyEmpty.hidden = history.length > 0;
    clearHistory.hidden = history.length === 0;
    history.forEach(sql => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'query-history-item';
      button.textContent = sql.replace(/\s+/g, ' ');
      button.title = sql;
      button.addEventListener('click', () => {
        input.value = sql;
        highlightSql(sql);
        input.focus();
      });
      historyList.appendChild(button);
    });
  }

  function getSavedQueries() {
    try {
      const saved = JSON.parse(localStorage.getItem(savedKey) || '[]');
      return Array.isArray(saved) ? saved : [];
    } catch {
      return [];
    }
  }

  function useQuery(sql) {
    input.value = sql;
    highlightSql(sql);
    input.focus();
  }

  function renderSavedQueries() {
    const saved = getSavedQueries();
    savedQueryList.replaceChildren();
    savedQueryEmpty.hidden = saved.length > 0;
    [...saved, ...reusableSnippets].forEach((item, index) => {
      const row = document.createElement('div');
      row.className = 'saved-query-item';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'query-history-item';
      button.textContent = item.name;
      button.title = item.sql;
      button.addEventListener('click', () => useQuery(item.sql));
      row.appendChild(button);
      if (index < saved.length) {
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'text-button';
        remove.textContent = '×';
        remove.title = 'Remove saved query';
        remove.addEventListener('click', () => {
          const next = getSavedQueries().filter(candidate => candidate.name !== item.name);
          localStorage.setItem(savedKey, JSON.stringify(next));
          renderSavedQueries();
        });
        row.appendChild(remove);
      }
      savedQueryList.appendChild(row);
    });
  }

  function saveCurrentQuery() {
    const sql = input.value.trim();
    if (!sql) return input.focus();
    const name = prompt('Name this query:', sql.split(/\s+/).slice(0, 5).join(' '));
    if (!name?.trim()) return;
    const saved = getSavedQueries().filter(item => item.name !== name.trim());
    saved.unshift({ name: name.trim(), sql });
    localStorage.setItem(savedKey, JSON.stringify(saved.slice(0, 30)));
    renderSavedQueries();
  }

  function currentToken() {
    return input.value.slice(0, input.selectionStart).match(/[a-zA-Z0-9_.]*$/)?.[0] || '';
  }

  function showSuggestions(force = false) {
    const token = currentToken();
    if (!force && token.length < 2) {
      suggestions.hidden = true;
      return;
    }
    const choices = [...keywords, ...autocomplete.schemas, ...autocomplete.tables, ...autocomplete.columns]
      .filter((choice, index, all) => all.indexOf(choice) === index)
      .filter(choice => force || choice.toLocaleLowerCase().includes(token.toLocaleLowerCase()))
      .slice(0, 12);
    suggestions.replaceChildren();
    choices.forEach(choice => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = choice;
      button.addEventListener('click', () => {
        const start = input.selectionStart - token.length;
        input.setRangeText(choice, start, input.selectionStart, 'end');
        suggestions.hidden = true;
        highlightSql(input.value);
        input.focus();
      });
      suggestions.appendChild(button);
    });
    suggestions.hidden = choices.length === 0;
  }

  input.addEventListener('input', () => {
    highlightSql(input.value);
    showSuggestions();
  });
  input.addEventListener('scroll', () => {
    highlightLayer.scrollTop = input.scrollTop;
    highlightLayer.scrollLeft = input.scrollLeft;
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      form.requestSubmit();
    } else if (event.key.toLocaleLowerCase() === 's' && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      saveCurrentQuery();
    } else if (event.key === ' ' && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      showSuggestions(true);
    } else if (event.key === 'Tab') {
      event.preventDefault();
      input.setRangeText('  ', input.selectionStart, input.selectionEnd, 'end');
      highlightSql(input.value);
    } else if (event.key === 'Escape') {
      suggestions.hidden = true;
    }
  });

  explainButton.addEventListener('click', () => {
    const sql = input.value.trim();
    if (!sql) {
      input.focus();
      return;
    }
    const prefix = form.dataset.explainPrefix || 'EXPLAIN ';
    input.value = `${prefix}${sql.replace(/^(EXPLAIN(?:\s+QUERY\s+PLAN)?\s+)/i, '')}`;
    highlightSql(input.value);
    form.requestSubmit();
  });

  clearHistory.addEventListener('click', () => {
    localStorage.removeItem(historyKey);
    renderHistory();
  });
  saveQueryButton.addEventListener('click', saveCurrentQuery);

  form.addEventListener('submit', async function (event) {
    event.preventDefault();
    saveHistory(input.value);
    queryId = globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`;
    const body = new URLSearchParams(new FormData(form));
    body.set('queryId', queryId);
    executeButton.disabled = true;
    if (cancelButton) cancelButton.hidden = false;
    status.textContent = 'Running query…';

    try {
      const response = await fetch(form.action, { method: 'POST', body });
      const html = await response.text();
      document.open();
      document.write(html);
      document.close();
    } catch (error) {
      status.textContent = `Request failed: ${error instanceof Error ? error.message : String(error)}`;
      executeButton.disabled = false;
      if (cancelButton) cancelButton.hidden = true;
    }
  });

  cancelButton?.addEventListener('click', async function () {
    if (!queryId) return;
    cancelButton.disabled = true;
    status.textContent = 'Cancelling query…';
    const cancelUrl = '<%= data.database ? '/db/' + encodeURIComponent(data.database) + '/query/cancel' : '/query/cancel' %>';
    const response = await fetch(cancelUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ queryId }),
    });
    status.textContent = response.ok ? 'Cancellation requested…' : 'Query already completed.';
  });

  highlightSql(input.value);
  renderHistory();
  renderSavedQueries();

  document.querySelectorAll('[data-export-result]').forEach(button => {
    button.addEventListener('click', () => {
      const rows = JSON.parse(document.getElementById('sqlResultData').textContent);
      const format = button.dataset.exportResult;
      const fields = rows.length ? Object.keys(rows[0]) : [];
      const csvCell = value => {
        const normalized = value && typeof value === 'object' ? JSON.stringify(value) : String(value ?? '');
        return `"${normalized.replace(/"/g, '""')}"`;
      };
      const content = format === 'json'
        ? JSON.stringify(rows, null, 2)
        : [fields.map(csvCell).join(','), ...rows.map(row => fields.map(field => csvCell(row[field])).join(','))].join('\\r\\n');
      const blob = new Blob([content], { type: format === 'json' ? 'application/json' : 'text/csv' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `query-result.${format}`;
      link.click();
      URL.revokeObjectURL(link.href);
    });
  });
})();
</script>
